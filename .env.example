# make sure you have your own .env file and copy this into your .env and then change from your env. 
# anything on .env is ignored by git for saftly.

# Application settings
APP_VERSION=1.0.1
APP_ENV=development
APP_PORT=8080

# Database connection
# Use localhost if the database runs directly on your computer.
# Use the Docker Compose service name if the database runs in Docker.
# Otherwise, use the database server's hostname or IP address.
DB_HOST=your_database_host

# Host port for connecting to Docker PostgreSQL from your PC
POSTGRES_PORT=your-continer-host-port

# Database port (example: PostgreSQL 5432, SQL Server 1433)
DB_PORT=your_database_port

# Database name
DB_NAME=myapp

# Database credentials
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# vite api url

VITE_API_URL= YOUR URL

# Optional: define this only if your backend requires a full connection string.
# Substitute the actual values when building the connection string.
CONNECTION_STRING=Host=db;Port=;Database=myapp;Username=your_db_username;Password=your_db_password